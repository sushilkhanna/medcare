# Copy this file to .env and fill in real values.
# Then load it before running, e.g.:
#   set -a && source .env && set +a && ./run.sh

DATABASE_URL=jdbc:postgresql://localhost:5432/medcare_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Generate a real 256-bit+ Base64 secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-base64-encoded-value
JWT_EXPIRATION_MS=86400000

# Comma-separated, no trailing slashes
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Production: use "validate" and manage schema with Flyway/Liquibase instead
DDL_AUTO=update

APP_LOG_LEVEL=INFO

# AI Assistant on the Buy Medicine page (free key: https://console.groq.com/keys)
# Check https://console.groq.com/docs/deprecations before deploying — Groq
# regularly retires free-tier models, and a decommissioned model ID here is
# the #1 cause of "couldn't reach the AI assistant" errors in production.
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_API_MODEL=openai/gpt-oss-20b
